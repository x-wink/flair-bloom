[Unit]
Description=FlairBloom GitHub Releases 镜像同步
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=flair-bloom
Group=flair-bloom
Environment=MIRROR_ROOT=/opt/flair-bloom/mirror
# 可选：放 GITHUB_TOKEN 提高 API 限额；未认证每小时 60 次，10 分钟一轮两次请求用不完
# MIRROR_DOWNLOAD_PROXY 默认 https://gh-proxy.com/，设为空只直连
EnvironmentFile=-/opt/flair-bloom/mirror.env
ExecStart=/usr/local/bin/node /opt/flair-bloom/mirror-app/sync-releases.ts
# 经代理拉三个版本实测 9 秒；上限按代理不可用、回落直连约 20 KB/s 的最坏情况留；运行期间定时器不会重叠触发
TimeoutStartSec=90min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/flair-bloom/mirror
