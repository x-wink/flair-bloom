{
  "name": "flair-bloom",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter main tauri dev",
    "build": "pnpm --filter main tauri build",
    "check:resources": "tsx scripts/check-ddhid-resources.ts",
    "check:release": "tsx scripts/verify-release-assets.ts",
    "lint": "oxlint apps/main/src",
    "lint:fix": "oxlint --fix apps/main/src",
    "format": "oxfmt apps/main/src",
    "format:check": "oxfmt --check apps/main/src",
    "coverage": "cargo llvm-cov --package qzh-format --package qzh-profile --package crypto --package migrate --package win-foreground --summary-only",
    "coverage:html": "cargo llvm-cov --package qzh-format --package qzh-profile --package crypto --package migrate --package win-foreground --html --open",
    "icon": "pnpm --filter main tauri icon src/assets/icon.png",
    "bump-version": "tsx scripts/bump-version.ts",
    "skills:check": "tsx scripts/check-skills.ts",
    "test:ui": "node --test \"scripts/**/*.test.ts\""
  },
  "devDependencies": {
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "tsx": "latest"
  }
}
